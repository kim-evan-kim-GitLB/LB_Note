# 배포용 환경변수 예시. 복사해서 deploy/.env.deploy 로 저장하고 비밀값을 채운다.
#   cp deploy/.env.deploy.example deploy/.env.deploy
# .env.deploy 는 비밀값이 들어가므로 절대 커밋하지 않는다(.gitignore 확인).

# ----- 인증/계정 -----
# 초기 계정 시드. 형식: id:pw,id:pw  (사용자가 비번을 바꾸면 재기동해도 보존됨)
WEB_AUTH_USERS=admin:CHANGE_ME_STRONG,dev:CHANGE_ME_STRONG
# 관리자 권한 부여할 id 목록(쉼표 구분)
WEB_AUTH_ADMINS=admin
# prune OFF 필수: 계정 진실원천은 DB. 스크립트(tools/bulk_create_users.py)나 셀프로 만든
# 계정을 부팅 시 지우지 않는다. (1로 두면 WEB_AUTH_USERS 에 없는 계정이 재기동마다 삭제됨)
WEB_AUTH_PRUNE=0
# JWT 서명 키. 반드시 길고 무작위한 값으로 교체(예: openssl rand -hex 32).
JWT_SECRET=CHANGE_ME_RANDOM_HEX
# 사용자별 Claude 자격증명(API키/구독토큰)의 at-rest 암호화 키(Fernet). 설정하면 DB 의
# claude_credentials.secret 가 암호화 저장되고 부팅 시 기존 평문을 자동 재암호화한다.
# 미설정이면 평문 저장(기존 동작 — 무중단). 생성:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 주의: 이 키를 분실/변경하면 저장된 자격증명을 복호할 수 없다(사용자 재입력 필요). 분실 시
#       복구 불가이므로 JWT_SECRET 과 함께 안전히 보관한다.
CRED_ENC_KEY=CHANGE_ME_FERNET_KEY

# ----- Slack 컨트롤 봇 (slackbot 서비스) -----
# Slack 앱에서 발급받은 토큰 2개. 미설정이면 slackbot 컨테이너가 기동 시 즉시 종료된다
# (config.validate 가 RuntimeError). 봇을 안 쓰려면 compose 에서 slackbot 서비스를 빼거나
# `docker compose up meetscript caddy` 로 봇 없이 기동한다.
#   SLACK_APP_TOKEN : Basic Information > App-Level Tokens 의 xapp-... (connections:write)
#   SLACK_BOT_TOKEN : 워크스페이스 설치 후 OAuth & Permissions 상단의 xoxb-...
# 앱 생성은 docs/slack-app-manifest.yml 을 붙여넣어 1회 수행. JWT_SECRET(위)을 웹과 공유한다.
SLACK_BOT_TOKEN=xoxb-CHANGE_ME
SLACK_APP_TOKEN=xapp-CHANGE_ME
# (선택) 반응 허용 채널 ID CSV. 비우면 모든 채널에서 반응. 비번초기화 결과는 항상 DM 전용.
SLACK_ALLOWED_CHANNELS=
# (선택) 공지 브로드캐스트 대상 채널 ID. 비우면 명령이 온 채널로 공지.
# 공지 내용은 웹 관리자 콘솔에서 작성(DB 저장) → 봇 `공지` 명령이 최신 공지를 읽어 이 채널에 게시.
SLACK_NOTICE_CHANNEL=

# ----- 후처리 백엔드 -----
# 정제는 segment 당 1콜이라 비싸므로 passthrough(원문 유지) 권장.
WEB_CLEAN_BACKEND=passthrough
# 요약/추출은 회의당 1콜이라 저비용 -> claude(agent_cli). 단, 자격증명은 사용자별로
# 각자 설정 화면에서 입력해야 동작(전역 키 주입 없음). 미설정 사용자는 요약/추출 빈 값.
WEB_EXTRACT_BACKEND=agent_cli
WEB_SUMMARIZE_BACKEND=agent_cli
# agent_cli(claude -p) 콜당 타임아웃(초). 긴 회의 단일콜 대비 여유있게.
AGENT_CLI_TIMEOUT=600
# 동시 STT 추론 수. 초과 요청은 대기(잡 status=queued, 프론트 "처리 대기 중…").
# 2 로 상향(2026-07-28): 잡 1건이 멈춰도 나머지 슬롯이 살아 전면 정지를 막는다.
# 요청마다 모델을 load 하는 구조라 슬롯당 모델 사본이 따로 올라간다 → 슬롯 2개면
# 약 (모델 3.9GB + 배치 3.4GB) x 2 + CUDA 컨텍스트 1GB = 약 16GB 가 필요하다.
# VRAM 이 빠듯하거나 GPU 를 다른 작업과 공유하면 1 로 되돌릴 것.
WEB_STT_CONCURRENCY=2

# VAD 분할 청크 배치 디코딩 크기(기본 32). 8 -> 32 상향 근거는 src/config.py 주석 참조:
# 51.5분 음원 18.1s -> 8.2s(2.22배), WER 0.400 -> 0.398, VRAM +1.5GB.
# VRAM 이 부족한 환경에서는 8~16 으로 낮출 것.
STT_BATCH_SIZE=32

# 이 프로세스가 쓸 VRAM 상한(MiB). 0 이면 제한 없음.
# GPU 를 다른 작업자의 학습/실험과 공유하는 서버라면 반드시 걸 것 — 상한이 없으면 STT 가
# 남의 작업을 OOM 으로 죽일 수 있고, 그쪽 피해(수 시간치 학습)가 훨씬 크다. 상한을 걸면
# 초과 시 STT 잡이 먼저 실패하므로 사고가 이쪽에서 멈춘다(사용자에게는 stt_vram_exhausted).
# 기본 20GB — 실측 최대(슬롯 2 x bs=32 동시 = 13.2GB)보다 충분히 크다. 독점 GPU 면 0.
STT_VRAM_CAP_MB=20480

# ----- 경로(보통 기본값 사용, 이미지 ENV 와 동일) -----
# COHERE_MODEL_PATH=/app/models/cohere-transcribe-03-2026
# WEB_FRONTEND_DIST=/app/web-dist
# 전처리 인핸서(기본 없음). 울림이 심한 원거리 녹음에만 "wpe" 를 켠다 — WPE 는 CPU 전용이라
# STT 시간이 30배 가까이 늘어난다(2026-07-29 실측, src/config.py 주석 참조). "wpe,gtcrn" 도 가능.
# ENHANCERS=

# ----- 호스트측(compose 변수) -----
# git clone 한 백엔드/프론트 repo 경로(빌드 컨텍스트)
BACKEND_DIR=/opt/meetscript/app
FRONTEND_DIR=/opt/meetscript/frontend
# 모델 가중치(3.9G)를 1회 배치한 호스트 경로 (필수 - docker cp 또는 재다운로드)
MODELS_DIR=/opt/meetscript/models
# DB(SQLite)·산출물 영속 호스트 경로 (host-dir bind). DB 는 여기 web/meetings.db 로 떨어진다.
# 기존 계정 DB 를 승계하려면 이 경로의 web/ 에 meetings.db 를 미리 복사해 둔다.
DATA_DIR=/opt/meetscript/data
# 호스트에서 노출할 포트(HTTPS, caddy TLS 종단). 사용자는 https://<LAN-IP>:49152 로 접속.
# (caddy 가 이 포트를 받아 내부 meetscript:8088 로 프록시 — 평문 8088 은 호스트에 노출 안 됨)
HOST_PORT=49152
# [필수] 사용자가 접속하는 171 서버 LAN IP(또는 접속용 호스트명). deploy/gen-cert.sh 가 이 값을
# 인증서 SAN 에 넣어 self-signed cert 를 만들고 caddy 가 그걸 물린다. 이게 비거나 실제 접속
# 주소와 다르면 https 접속이 TLS 오류/이름불일치로 실패한다. SITE_HOST 변경 시 gen-cert.sh 재실행.
#   - IP 로 접속하면 그 IP 를 적는다(예: 121.125.78.171).
#   - 사내 DNS 호스트명으로 접속하면 그 호스트명을 적는다(예: meetscript.lan).
#   - 여러 경로면 쉼표로(예: 121.125.78.171,meetscript.lan).
SITE_HOST=121.125.78.171
